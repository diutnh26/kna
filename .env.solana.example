# Solana / chain worker configuration (copy to secrets/.env.solana)
# Cluster MUST be devnet for hackathon — mainnet guard will hard-fail otherwise.

SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional: https://devnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_API_KEY=

# Devnet program (must match declare_id! / Anchor.toml / chain-client)
KNA_TRUST_PROGRAM_ID=2Ft67fV4Zn747zYiKneYPwUH9ZZGKFFt1rT5KUq9JK6f

# Squads v4 vault PDA (Committee authority). Live demo vault:
# 3yY8ey4qCgN6kRLdbobDKU78siQJqWgP8Hum1sUcia42
KNA_COMMITTEE_VAULT=

# Chain worker (API reads these when SOLANA_ENABLED=true)
SOLANA_ENABLED=true
CHAIN_WORKER_ENABLED=true
CHAIN_WORKER_POLL_MS=5000
CHAIN_WORKER_LEASE_SEC=60
COORDINATOR_KEYPAIR_PATH=./secrets/coordinator-keypair.json

# Wallet link challenge domain (must match frontend)
WALLET_LINK_DOMAIN=kna.local
WALLET_LINK_TTL_SEC=300
