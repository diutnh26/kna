// KNĂ — Phase 1 data model.
//
// Runs on PostgreSQL everywhere: a local instance for development and
// tests, Neon for staging and production. Only the connection string
// differs between them.
//
// No `enum` blocks, and no `@unique` on LedgerEntry's nullable foreign
// keys. Both are legacies of a period on SQL Server, and both are kept
// deliberately: the permitted values live in src/lib/enums.ts enforced by
// CHECK constraints, and the "at most one ledger entry per booking" rule
// is a partial unique index. Postgres supports enums and treats NULLs as
// distinct, so it would tolerate the simpler forms — but this shape works
// on both engines, and the plan still contemplates Azure SQL later.
//
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Migrations run over a direct connection, never a pooler. Neon's pooled
  // endpoint is PgBouncer in transaction mode, which does not support the
  // session-level advisory locks Prisma Migrate relies on. Locally both
  // point at the same server, so this changes nothing there.
  directUrl = env("DIRECT_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ── Identity ──────────────────────────────────────────────

// Note: this is a coarse account type, not the source of truth for what
// someone may do. Committee authority comes from a CommitteeMember row and
// provider status from a Provider row, because one person can hold both —
// see src/middleware/auth.ts.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Nullable: Google-only accounts have no password. Password login fails
  // with a generic message when this is null.
  passwordHash String?
  fullName     String
  role         String   @default("GUEST")
  locale       String   @default("en") // "en" | "vi"
  // Google subject ("sub") claim. Unique when present; null for password-only.
  googleSub    String?  @unique
  // Soft gate: account is usable immediately; verification is encouraged.
  emailVerified     Boolean   @default(false)
  emailVerifyToken  String?   @unique
  emailVerifyExpiry DateTime?
  // Bumped whenever authority changes or the account signs out everywhere.
  // A token carrying a stale version is rejected, which is what makes
  // withdrawing a seat or a coordinator role take effect now rather than
  // whenever the old token happens to expire.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  provider      Provider?
  bookings      Booking[]
  orders        Order[]
  committeeSeat CommitteeMember?

  contributedEntries ArchiveEntry[] @relation("ArchiveContributor")
  moderatedEntries   ArchiveEntry[] @relation("ArchiveModerator")
  notifications      Notification[]
  walletLink         WalletLink?
  wallet             Wallet?
  topUps             TopUp[]
  refreshTokens      RefreshToken[]
}

/**
 * Opaque refresh credentials. The raw token lives only in an HttpOnly cookie;
 * we store a SHA-256 hash so a DB leak cannot mint sessions. Rotated on every
 * use; revoked on logout / tokenVersion bump.
 */
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/**
 * Something that happened which a particular person should know about.
 *
 * Stores a key and its parameters rather than a rendered sentence. This
 * platform is bilingual and a person can change their language at any
 * time; a notification written in English at the moment a coordinator
 * pressed confirm would still be English a month later, on a screen the
 * rest of which had switched to Vietnamese.
 *
 * Every row belongs to exactly one reader. A booking confirmation is news
 * to the guest and to the household, and each gets their own row — they
 * read it at different times, and one marking it read must not clear it
 * for the other.
 */
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // CHECK-constrained, like every other enum-shaped column here.
  type      String
  // Interpolation values for the i18n key named by `type`.
  params    Json     @default("{}")
  // Where reading it should take the person, e.g. "#account".
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ── Supply ────────────────────────────────────────────────

model Provider {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  type        String
  displayName String
  buon        String // village, e.g. "Buôn Akô Dhông"
  bio         String?
  // Path or URL to a photograph. Nullable on purpose: a provider without a
  // photograph is a normal state, not a broken one, and the UI falls back
  // to a labelled placeholder. Holding a URL rather than bytes means the
  // move to object storage later is a data change, not a schema change.
  imageUrl    String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  listings Listing[]
  products Product[]
}

model Listing {
  id           String   @id @default(cuid())
  providerId   String
  provider     Provider @relation(fields: [providerId], references: [id])
  category     String
  title        String
  blurb        String
  priceVnd     Int
  unit         String // "per night" | "per person"
  duration     String // "4 hours" | "2 nights" | "1 night minimum" — free text, host's own words
  groupSize    String // "Up to 6 guests" — free text, host's own words
  carbonRating String // "Low" | "Very low" ...
  customs      String?
  imageUrl     String?
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  // What one day's slot holds: rooms for a per-night stay, seats for a
  // per-person experience. The provider opens dates at this capacity.
  inventory        Int @default(1)
  maxGuestsPerRoom Int @default(2)

  slots    AvailabilitySlot[]
  bookings Booking[]
}

/// One open day of a listing, opened by its provider. `capacity` and
/// `booked` count rooms (stays) or seats (experiences). A CHECK constraint
/// holds 0 <= booked <= capacity, so no code path can overbook.
model AvailabilitySlot {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  date      DateTime
  capacity  Int
  booked    Int      @default(0)

  @@unique([listingId, date])
}

// ── Commerce ──────────────────────────────────────────────

// NoAction on the relations below is required by SQL Server, which refuses
// multiple cascade paths to the same table — Booking reaches User both
// directly (guest) and via Listing -> Provider. It is also the behaviour
// this system wants: bookings, orders and ledger rows are financial
// record. Deleting a User must fail rather than silently erase a
// household's earnings history. SQLite accepted the cascades and would
// never have surfaced this.
//
// A Booking's totalVnd always splits as:
//   platformFeeVnd (7%) + communityFundVnd (3%) + providerPayoutVnd (90%)
// See LedgerEntry — this split is what the public transparency table renders.
model Booking {
  id                String   @id @default(cuid())
  listingId         String
  listing           Listing  @relation(fields: [listingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  guestId           String
  guest             User     @relation(fields: [guestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status            String   @default("PENDING")
  guests            Int
  // `nights` was accepted by the API and multiplied into the price, then
  // dropped — it was never a column. So the total could not be audited
  // back to the inputs that produced it, and a coordinator confirming a
  // booking had no idea which dates to check with the household. Both are
  // stored now.
  checkIn           DateTime @db.Date
  nights            Int      @default(1)
  totalVnd          Int
  platformFeeVnd    Int
  communityFundVnd  Int
  providerPayoutVnd Int
  // VietQR / payment gateway tracking
  paymentRef      String?
  paymentStatus   String    @default("AWAITING_PAYMENT")
  paymentPaidAt   DateTime?
  // Demo SPL token disbursement (devnet) — JSON array of tx signatures
  demoTxSigs      String?
  demoDisburseAt  DateTime?
  // Rooms held (stays) or seats (experiences), and the day payment opens.
  rooms           Int       @default(1)
  checkOut        DateTime?
  // create_booking on devnet
  onchainTx       String?
  onchainError    String?
  // pay_booking on devnet (check-out), and how far the payment reminders
  // have got: 0 none, 1 due sent, 2 overdue sent, 3 auto-charge attempted.
  payTx           String?
  reminderStage   Int       @default(0)
  // Who moved it out of PENDING, when, and by which path: COORDINATOR (the
  // decision route), PAYMENT_VERIFY (a coordinator syncing the bank) or
  // PAYMENT_WEBHOOK (no user). A money decision always leaves a trace.
  decidedById     String?
  decidedAt       DateTime?
  decidedVia      String?
  createdAt         DateTime @default(now())

  ledgerEntries LedgerEntry[]
  offset        OffsetContribution?
}

/**
 * A carbon offset attached to a booking.
 *
 * Attached rather than standalone on purpose: the guest pays for it with
 * the stay, and it is settled when the stay is. So there is no status
 * column here — an offset is exactly as real as the booking it hangs off,
 * and deriving that avoids a second copy of the truth that could drift.
 *
 * At most one per booking. Offsetting the same trip twice would double
 * count on the public ledger, which is the one place this platform cannot
 * afford an inflated number.
 */
model OffsetContribution {
  id        String   @id @default(cuid())
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // "yokdon" | "lak" | "corridor" — CHECK-constrained, like every other
  // enum-shaped column in this schema.
  projectId String
  kgCo2e    Int
  amountVnd Int
  // How the guest chose to contribute.
  //   IN_PERSON    — they will work a session that runs during their stay
  //   NEXT_SESSION — no session runs during their stay, so they register
  //                  for the next one and come back for it
  //   DONATE       — money
  mode      String
  // The session they committed to, for the two modes that involve turning
  // up. Stored rather than recomputed: the schedule is a constant in the
  // code today, and a guest who was told "5–7 September" should still see
  // that a year later even if the anchor or the interval move.
  sessionStart DateTime? @db.Date
  sessionEnd   DateTime? @db.Date
  // The origin the guest travelled from. Kept so a donation can be audited
  // back to the rate it was charged at — the international share only
  // applies to some origins, and a figure on a public ledger should be
  // reconstructable a year later. CHECK-constrained like every other
  // enum-shaped column here.
  origin    String
  createdAt DateTime @default(now())

  ledgerEntries LedgerEntry[]
}

model Product {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id])
  category   String // "Textile" | "Woodwork" | "Basketry" | ...
  title      String
  note       String
  priceVnd   Int
  stock      Int
  imageUrl   String?
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())

  orderItems OrderItem[]
}

// An Order's totalVnd splits as marketplaceFeeVnd (5%) + artisan payout (95%).
model Order {
  id                String   @id @default(cuid())
  buyerId           String
  buyer             User     @relation(fields: [buyerId], references: [id])
  status            String   @default("PENDING")
  totalVnd          Int
  marketplaceFeeVnd Int
  paymentRef      String?
  paymentStatus   String    @default("AWAITING_PAYMENT")
  paymentPaidAt   DateTime?
  // Who moved it out of PENDING, when, and by which path: COORDINATOR (the
  // decision route), PAYMENT_VERIFY (a coordinator syncing the bank) or
  // PAYMENT_WEBHOOK (no user). A money decision always leaves a trace.
  decidedById     String?
  decidedAt       DateTime?
  decidedVia      String?
  createdAt         DateTime @default(now())

  items         OrderItem[]
  ledgerEntries LedgerEntry[]
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  quantity     Int
  unitPriceVnd Int
}

// ── Trust & governance ───────────────────────────────────
// The Phase 1 "Proof of Impact" — a plain, publicly-readable ledger.
// Becomes the reconciliation target for the Phase 2 smart contract.

// bookingId/orderId are NOT marked @unique, deliberately. SQL Server
// treats NULLs as equal in a UNIQUE constraint, so a plain unique index on
// a nullable column permits exactly one NULL — which would mean only one
// order-derived ledger row could ever exist. The real rule (at most one
// entry per booking, and per order) is enforced by filtered unique indexes
// added in the `ledger_filtered_unique` migration. Prisma cannot express a
// filtered index, so it models these as one-to-many; the routes still
// return a single `ledgerEntry`.
model LedgerEntry {
  id               String   @id @default(cuid())
  bookingId        String?
  booking          Booking? @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderId          String?
  order            Order?   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  offsetId         String?
  offset           OffsetContribution? @relation(fields: [offsetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromLabel        String // "Traveler #4821"
  toLabel          String // "H'Bia Homestay"
  totalVnd         Int
  platformFeeVnd   Int
  communityFundVnd Int
  createdAt        DateTime @default(now())
  // The ledger is append-only: a row that no longer stands (declined booking,
  // cancelled order, withdrawn offset) is voided, never deleted.
  voidedAt         DateTime?
  voidReason       String?
  voidedById       String?

  attestation LedgerAttestation?
}

model CommunityFundEntry {
  id        String   @id @default(cuid())
  quarter   String // "Q2 2026"
  what      String
  toBuon    String
  amountVnd Int
  createdAt DateTime @default(now())
}

model CommitteeMember {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  role      String // "Chair · elder", "Guides and land use", ...
  buon      String
  since     String
  // Display order is a curatorial decision by the community (the chair
  // leads the list), not creation order — so it's stored, not inferred.
  sortOrder Int    @default(0)
}

model CommitteeDecision {
  id        String   @id @default(cuid())
  status    String // "passed" | "declined"
  title     String
  fromLabel String
  date      DateTime
  note      String
  createdAt DateTime @default(now())
}

// ── Content ───────────────────────────────────────────────

// Nothing here reaches the public archive without a Committee member
// moving it to PUBLISHED. That review step is the point of the model —
// see the moderation routes in src/routes/archive.ts.
model ArchiveEntry {
  id               String   @id @default(cuid())
  type             String // "Oral history" | "360° tour" | "Recording" | ...
  title            String
  meta             String
  keeperBuon       String
  body             String?
  // Editorial grouping on the Explore page: "Cồng Chiêng" | "The Long
  // House" | "Weaving". Null for entries that sit outside the three.
  pillar           String?
  imageUrl         String?
  moderationStatus String   @default("IN_REVIEW")
  createdAt        DateTime @default(now())

  contributedById String?
  contributedBy   User?     @relation("ArchiveContributor", fields: [contributedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  moderatedById   String?
  moderatedBy     User?     @relation("ArchiveModerator", fields: [moderatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  moderatedAt     DateTime?
  // The Committee's reason, kept for both outcomes. A refusal without a
  // recorded reason isn't a governance record.
  moderationNote  String?

  chainRef ChainEntityRef?
}

// ── Solana trust layer (Track 2) ──────────────────────────

/// The account's fixed wallet: created by the platform at sign-up, its key
/// held encrypted (lib/walletCrypto.ts), registered on-chain once with
/// register_account. One per user, never replaced.
model Wallet {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pubkey          String    @unique
  encryptedSecret String
  createdAt       DateTime  @default(now())
  // register_account on devnet
  registeredTx    String?
  registeredAt    DateTime?
  registerError   String?
}

/// dKNA credited to an account's fixed wallet: a VietQR top-up (VND paid,
/// then minted) or the demo faucet (devnet only, rate-limited).
model TopUp {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  source     String    // "VIETQR" | "FAUCET"
  amountVnd  Int
  paymentRef String?   @unique
  status     String    @default("AWAITING_PAYMENT") // AWAITING_PAYMENT | PAID | CREDITED | FAILED
  mintTx     String?
  error      String?
  createdAt  DateTime  @default(now())
  paidAt     DateTime?

  @@index([userId, createdAt])
}

/// A wallet the user brings (Phantom). When `isDefault`, it pays their
/// bookings instead of the fixed wallet (set_payment_wallet on-chain).
model WalletLink {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pubkey          String   @unique
  challengeNonce  String?
  challengeExpiry DateTime?
  linkVersion     Int      @default(1)
  linkedAt        DateTime @default(now())
  isDefault       Boolean  @default(false)
  paymentWalletTx String?
}

model ChainOutbox {
  id             String   @id @default(cuid())
  eventType      String
  payload        Json
  idempotencyKey String   @unique
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  leaseUntil     DateTime?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, leaseUntil])
}

model LedgerAttestation {
  id             String      @id @default(cuid())
  ledgerEntryId  String      @unique
  ledgerEntry    LedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payloadHash    String
  pendingPda     String?
  finalPda       String?
  pendingTxSig   String?
  finalizeTxSig  String?
  // Set when the coordinator withdraws the attestation before the committee
  // finalizes it (cancel_pending). CANCELLED is terminal on-chain: the
  // pending PDA stays, so the same ledger entry cannot be attested again.
  cancelTxSig    String?
  cancelReason   String?
  slot           BigInt?
  state          String      @default("PENDING_SIGNATURE")
  lastError      String?
  cluster        String?
  programId      String?
  payloadVersion Int         @default(1)
  verifiedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([state])
}

model ChainEntityRef {
  id             String        @id @default(cuid())
  entityType     String
  entityId       String
  pdaAddress     String
  createdAt      DateTime      @default(now())
  archiveEntryId String?       @unique
  archiveEntry   ArchiveEntry? @relation(fields: [archiveEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([entityType, entityId])
}

model ChainAuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  action        String
  ledgerEntryId String?
  detail        String?
  createdAt     DateTime @default(now())

  @@index([ledgerEntryId])
  @@index([createdAt])
}

// The phrasebook. Reviewed the same way as the archive: the Committee
// decided in April 2026 that everyday speech is publishable and
// ceremonial/clan-specific speech is not, so each phrase clears review.
model Phrase {
  id               String   @id @default(cuid())
  ede              String
  en               String
  note             String
  sortOrder        Int      @default(0)
  moderationStatus String   @default("IN_REVIEW")
  createdAt        DateTime @default(now())
}
