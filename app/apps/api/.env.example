# PostgreSQL everywhere: a local instance for development and tests, Neon
# for staging and production. Only the connection string differs.
#
# Local (the portable install uses trust auth, so no password):
DATABASE_URL="postgresql://postgres@localhost:5432/kna_dev"
#
# Neon (staging/production) — note sslmode=require:
#   DATABASE_URL="postgresql://<user>:<pw>@<host>-pooler.neon.tech/neondb?sslmode=require"
#
# Neon also needs a direct (non-pooled) URL for migrations — the pooled
# endpoint is PgBouncer in transaction mode and cannot run them. Locally
# both point at the same server.
DIRECT_DATABASE_URL="postgresql://postgres@localhost:5432/kna_dev"
#   DIRECT_DATABASE_URL="postgresql://<user>:<pw>@<host>.neon.tech/neondb?sslmode=require"

# The test suite uses its own database and never touches kna_dev.
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/kna_test"

PORT=4000
JWT_SECRET="dev-only-change-me"
CORS_ORIGIN="http://localhost:5173"
# Docker web is served on :8080 — set CORS_ORIGIN accordingly there:
# CORS_ORIGIN="http://localhost:8080"

# ── Session cookies (B2C auth) ─────────────────────────────
# Short-lived JWT in HttpOnly cookie `access_token`.
ACCESS_TOKEN_TTL=15m
# Opaque refresh token in HttpOnly cookie `refresh_token` (hash stored in DB).
REFRESH_TOKEN_TTL_DAYS=30
# Set true behind HTTPS in production.
COOKIE_SECURE=false
# lax when web and API share a site; none when they are on different sites
# (e.g. two *.onrender.com hosts). none forces Secure cookies.
COOKIE_SAMESITE=lax
# Used in email-verification links (hash router: /#account?verify=…).
PUBLIC_BASE_URL=http://localhost:8080

# ── Google Sign-In (optional) ──────────────────────────────
# Create an OAuth 2.0 Client ID (Web) in Google Cloud Console.
# Authorized JavaScript origins: http://localhost:8080, http://localhost:5173
# Authorized redirect URIs: same origins (GIS popup flow).
# Also set VITE_GOOGLE_CLIENT_ID in the web build to the same value.
GOOGLE_CLIENT_ID=

# ── Mail (optional — soft gate) ────────────────────────────
# If SMTP_HOST is blank, verification tokens are still issued and the
# link is logged to the API console instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Legacy aliases still accepted by mail.ts:
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=noreply@kna.local
SMTP_SECURE=false

# Payment gateway. "manual" = coordinator arranges payment offline.
# "vietqr" = bank QR (img.vietqr.io) + webhook / verify → optional demo mint.
PAYMENT_PROVIDER="manual"
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_ID=TCB
ORDER_ID_PREFIX=TWRTCK
BOOKING_HOLD_MINUTES=10
PAYMENT_WEBHOOK_TOKEN=
PAYMENT_WEBHOOK_SECRET=

# VietQR proxy (transaction-sync) — only needed when PAYMENT_PROVIDER=vietqr
VIETQR_ENABLED=false
VIETQR_USERNAME=
VIETQR_PASSWORD=
VIETQR_BASE_URL=https://chat.thinhdoworks.com/api/v1
VIETQR_TOKEN_EXPIRES_SECONDS=300

# Approach A — demo SPL token on Solana devnet (optional).
# Create once: npx tsx scripts/setup-demo-mint.ts
DEMO_MINT=
DEMO_FUNDER_KEYPAIR_B58=
# Platform registrar: registers accounts, records bookings, pays network fees.
# Needs the coordinator role on-chain (setup-payments.ts grants it).
KNA_REGISTRAR_KEYPAIR_B58=
# 32 random bytes, base64. Encrypts the platform-held wallet keys at rest.
WALLET_ENCRYPTION_KEY=

# Solana trust layer (attestation / Squads) — separate from demo mint
SOLANA_ENABLED=false
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
KNA_COMMITTEE_VAULT=
