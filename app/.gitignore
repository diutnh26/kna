# Local Claude Code settings — per-machine, not project config
.claude/settings.local.json

# An empty stray directory at the repo root. Anchored with a leading slash:
# a bare `src/` matches a directory of that name at ANY depth, which
# silently excluded apps/web/src files from two commits.
/src/
