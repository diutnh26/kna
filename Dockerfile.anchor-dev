# Reproducible Anchor build environment (WSL/CI)
# Rust 1.79 base: anchor-cli 0.30.1 does not compile on 1.80+ (time crate).
# Program host tests use 1.84 via rustup + Anchor.toml toolchain.
FROM rust:1.79-bookworm

ARG SOLANA_VERSION=2.2.20
ARG ANCHOR_VERSION=0.30.1

RUN apt-get update && apt-get install -y pkg-config libssl-dev curl git && rm -rf /var/lib/apt/lists/*

RUN sh -c "$(curl -sSfL https://release.anza.xyz/v${SOLANA_VERSION}/install)" \
  && echo 'export PATH="/root/.local/share/solana/install/active_release/bin:$PATH"' >> /root/.bashrc

ENV PATH="/root/.local/share/solana/install/active_release/bin:${PATH}"

# Install avm from the matching tag — HEAD requires edition2024 / rustc 1.85+.
RUN cargo install --git https://github.com/coral-xyz/anchor --tag "v${ANCHOR_VERSION}" avm --locked --force \
  && avm install ${ANCHOR_VERSION} \
  && avm use ${ANCHOR_VERSION}

ENV PATH="/root/.avm/bin:${PATH}"

RUN rustup install 1.84.0 --profile minimal

WORKDIR /workspace/app
CMD ["bash", "-lc", "anchor build --no-idl && cargo test -p kna-trust-layer --lib"]
