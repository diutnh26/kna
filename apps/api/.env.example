# Local dev: SQLite, zero setup.
# Staging/prod: point at Azure SQL, e.g.
#   DATABASE_URL="sqlserver://<host>:1433;database=kna;user=...;password=...;encrypt=true"
# and switch prisma/schema.prisma's datasource provider to "sqlserver".
DATABASE_URL="file:./dev.db"

PORT=4000
JWT_SECRET="dev-only-change-me"
CORS_ORIGIN="http://localhost:5173"

# Payment gateway. "manual" = the pilot arrangement: a coordinator arranges
# payment with the household directly and nothing is charged through the site.
# Becomes "vnpay" or "momo" once a merchant account exists.
PAYMENT_PROVIDER="manual"
