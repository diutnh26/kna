# PostgreSQL everywhere: a local instance for development and tests, Neon
# for staging and production. Only the connection string differs.
#
# Local (the portable install uses trust auth, so no password):
DATABASE_URL="postgresql://postgres@localhost:5432/kna_dev"
#
# Neon (staging/production) — note sslmode=require:
#   DATABASE_URL="postgresql://<user>:<pw>@<host>-pooler.neon.tech/neondb?sslmode=require"
#
# Neon also needs a direct (non-pooled) URL for migrations — the pooled
# endpoint is PgBouncer in transaction mode and cannot run them. Locally
# both point at the same server.
DIRECT_DATABASE_URL="postgresql://postgres@localhost:5432/kna_dev"
#   DIRECT_DATABASE_URL="postgresql://<user>:<pw>@<host>.neon.tech/neondb?sslmode=require"

# The test suite uses its own database and never touches kna_dev.
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/kna_test"

PORT=4000
JWT_SECRET="dev-only-change-me"
CORS_ORIGIN="http://localhost:5173"

# Payment gateway. "manual" = the pilot arrangement: a coordinator arranges
# payment with the household directly and nothing is charged through the site.
# Becomes "vnpay" or "momo" once a merchant account exists.
PAYMENT_PROVIDER="manual"
# ── The assistant ────────────────────────────────────────────────────
# Nothing here is required to boot. Full reference and the reasoning:
# src/ai/README.md.
#
# Providers, in order of preference:
#   gemini — Google's Gemini API. Set GEMINI_API_KEY (aistudio.google.com)
#            and it becomes the default provider automatically. Defaults:
#            gemini-flash-latest + gemini-embedding-001 (3072 dims).
#   ollama — self-hosted models on localhost, the original pilot setup.
#   off    — a real mode, not a failure: the assistant serves
#            Committee-approved answers verbatim and declines the rest.
#            Also what the API degrades to whenever the backend stops
#            answering.
GEMINI_API_KEY=""
#AI_PROVIDER="gemini"
#
# Reference documents: PDF/DOCX files in this folder are chunked and
# embedded into the knowledge base by ai:sync, as source type
# "ReferenceDocument". Empty string disables ingestion (the tests do this).
#AI_REFERENCE_DIR="./data"
#
# After changing provider or embedding model, ALWAYS re-run:
#   npm run ai:sync --workspace apps/api        (re-embeds the corpus)
#   npm run ai:calibrate --workspace apps/api   (check the thresholds)
#
# Gemini overrides (defaults shown; 1.5/2.x flash are retired at Google,
# and 2.5-flash is closed to new API keys — the rolling alias avoids the
# treadmill, or pin a 3.x name):
#AI_CHAT_MODEL="gemini-flash-latest"
#AI_EMBED_MODEL="gemini-embedding-001"
#AI_EMBED_DIMENSIONS=3072
#
# Ollama overrides — sized for a 4 GB laptop GPU:
#OLLAMA_URL="http://localhost:11434"
#AI_CHAT_MODEL="qwen2.5:3b-instruct-q4_K_M"
#AI_EMBED_MODEL="bge-m3"
#AI_EMBED_DIMENSIONS=1024
#
# The two thresholds are the safety mechanism; they are per-embedding-model
# and have provider-aware defaults. Calibrate before moving them:
#   npm run ai:calibrate --workspace apps/api
#AI_CURATED_THRESHOLD=0.82
#AI_EVIDENCE_THRESHOLD=0.45
