# SQL Server everywhere: a local instance for development, Azure SQL for
# staging and production. Only the connection string differs.
#
# Local, Windows authentication (no password stored here):
DATABASE_URL="sqlserver://localhost:1433;database=kna_dev;integratedSecurity=true;trustServerCertificate=true"
#
# Local, SQL authentication — use this if your instance has Windows auth
# disabled, or you are not on Windows:
#   DATABASE_URL="sqlserver://localhost:1433;database=kna_dev;user=sa;password=...;encrypt=true;trustServerCertificate=true"
#
# Azure SQL:
#   DATABASE_URL="sqlserver://<server>.database.windows.net:1433;database=kna;user=<u>;password=<p>;encrypt=true"

# The test suite uses its own database and never touches kna_dev.
TEST_DATABASE_URL="sqlserver://localhost:1433;database=kna_test;integratedSecurity=true;trustServerCertificate=true"

PORT=4000
JWT_SECRET="dev-only-change-me"
CORS_ORIGIN="http://localhost:5173"

# Payment gateway. "manual" = the pilot arrangement: a coordinator arranges
# payment with the household directly and nothing is charged through the site.
# Becomes "vnpay" or "momo" once a merchant account exists.
PAYMENT_PROVIDER="manual"
